# 所有文本文件在 checkout 时保持 CRLF（.bat 必须 CRLF，否则 cmd 解析会错乱）
* text=auto eol=crlf

# 明确声明的文本类型
*.py    text  eol=crlf
*.bat   text  eol=crlf
*.cmd   text  eol=crlf
*.ps1   text  eol=crlf
*.md    text  eol=crlf
*.txt   text  eol=crlf
*.json  text  eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.exe   binary
